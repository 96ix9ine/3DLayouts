  m_text: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
    \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0441 3D \u043C\u043E\u0434\u0435\u043B\u044C\u044E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435:\n\n1. \u0417\u0430\u0436\u0430\u0442\u044C
    \u043B\u0435\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
    (\u041B\u041A\u041C) \u0434\u043B\u044F \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438
    \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438.\n\n2. \u0417\u0430\u0436\u0430\u0442\u044C
    \u043F\u0440\u0430\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438
    (\u041F\u041A\u041C) \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u043C\u043E\u0434\u0435\u043B\u0438 \u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438
    \u0438 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438\n\n3. \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0435\u043C/\u043E\u0442\u0434\u0430\u043B\u0435\u043D\u0438\u0435\u043C
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0443\u0442\u0435\u043C \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u043A\u0438
    \u043A\u043E\u043B\u0435\u0441\u0438\u043A\u0430 \u043C\u044B\u0448\u0438 \u0432\u043F\u0435\u0440\u0435\u0434/\u043D\u0430\u0437\u0430\u0434
    (\u0421\u041A\u041C)"
